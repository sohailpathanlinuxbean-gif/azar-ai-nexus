# @hookform/resolvers declares a peerOptional on valibot ^1.x while the tree
# resolves valibot 0.39, which makes `npm install` fail with ERESOLVE. Bun
# ignores peer conflicts, so this only matters when npm does the install
# (e.g. CI that doesn't detect the text-format bun.lock).
legacy-peer-deps=true
